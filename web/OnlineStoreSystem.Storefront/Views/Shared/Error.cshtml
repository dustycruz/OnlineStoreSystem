@* File: web/OnlineStoreSystem.Storefront/Views/Shared/Error.cshtml *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="alert alert-danger">
    <h1 class="h4">Something went wrong</h1>
    <p class="mb-2">@(Model.Message ?? "An unexpected error occurred while processing your request.")</p>
    @if (!string.IsNullOrEmpty(Model.CorrelationId))
    {
        <p class="mb-0 small">Quote this correlation id when reporting the problem: <code>@Model.CorrelationId</code></p>
    }
    @if (Model.ShowRequestId)
    {
        <p class="mb-0 small">Request id: <code>@Model.RequestId</code></p>
    }
</div>
<a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to the shop</a>
