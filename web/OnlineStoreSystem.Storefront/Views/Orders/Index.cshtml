@* File: web/OnlineStoreSystem.Storefront/Views/Orders/Index.cshtml *@
@model OrdersIndexViewModel
@{
    ViewData["Title"] = "My orders";
}
<div class="d-flex justify-content-between align-items-end mb-3">
    <h1 class="h3 mb-0">My orders</h1>
    <span class="small text-muted">customer id <code>@Model.CustomerId</code></span>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">Orders could not be loaded: @Model.ErrorMessage</div>
}
else if (Model.Orders.Count == 0)
{
    <div class="alert alert-info">You have not placed any orders yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Placed (UTC)</th>
                    <th class="text-end">Items</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><a asp-action="Status" asp-route-id="@order.OrderId">@order.OrderNumber</a></td>
                        <td>@order.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">@order.ItemCount</td>
                        <td class="text-end">@order.TotalAmount.ToString("N2") @order.Currency</td>
                        <td>
                            <span class="badge @OrderStatusViewModel.StatusBadge(order.Status)">@order.Status</span>
                            @if (!string.IsNullOrEmpty(order.FailureReason))
                            {
                                <div class="small text-muted">@order.FailureReason</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
