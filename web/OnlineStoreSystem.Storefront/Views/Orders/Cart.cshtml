@* File: web/OnlineStoreSystem.Storefront/Views/Orders/Cart.cshtml *@
@model CartViewModel
@{
    ViewData["Title"] = "Cart";
}
<h1 class="h3 mb-4">Your cart</h1>

@if (Model.IsEmpty)
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Browse the catalog</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Unit price</th>
                    <th style="width: 14rem">Quantity</th>
                    <th class="text-end">Line total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@line.ProductId">@line.Name</a>
                            <div class="small text-muted">SKU @line.Sku</div>
                        </td>
                        <td class="text-end">@line.UnitPrice.ToString("N2") @line.Currency</td>
                        <td>
                            <form method="post" asp-action="UpdateCart" class="d-flex gap-1">
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="number" name="quantity" value="@line.Quantity" min="0" max="1000" class="form-control form-control-sm qty-input" aria-label="Quantity" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">@line.LineTotal.ToString("N2") @line.Currency</td>
                        <td class="text-end">
                            <form method="post" asp-action="RemoveFromCart">
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Estimated total</th>
                    <th class="text-end">@Model.Total.ToString("N2") @Model.Currency</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="small text-muted">Final prices are confirmed by CatalogService when you check out.</p>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Catalog" asp-action="Index">Continue shopping</a>
        <a class="btn btn-success" asp-action="Checkout">Proceed to checkout</a>
    </div>
}
