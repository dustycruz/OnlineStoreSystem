// File: src/OnlineStoreSystem.CatalogService/appsettings.json
{
  "Urls": "http://localhost:5001",
  "ConnectionStrings": {
    // LocalDB (Windows). Alternatives:
    //   SQL Express : "Server=.\\SQLEXPRESS;Database=CatalogDb;Trusted_Connection=True;TrustServerCertificate=True"
    //   SQL auth    : "Server=localhost,1433;Database=CatalogDb;User Id=sa;Password=<pwd>;TrustServerCertificate=True"
    // Override without editing this file: env var ConnectionStrings__CatalogDb=...
    "CatalogDb": "Server=(localdb)\\mssqllocaldb;Database=CatalogDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "FaultInjection": {
    // Set to true (e.g. dotnet run -- --FaultInjection:Enabled=true) to fail the first N
    // requests of every correlation id with 503 and watch OrderService retry with backoff.
    "Enabled": false,
    "FailuresPerCorrelationId": 2,
    "StatusCode": 503,
    "PathPrefix": "/api/"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
