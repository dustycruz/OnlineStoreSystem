// File: src/OnlineStoreSystem.PaymentService/appsettings.json
{
  "Urls": "http://localhost:5004",
  "ConnectionStrings": {
    // Override with env var ConnectionStrings__PaymentDb=... (e.g. SQL auth on macOS/Linux).
    "PaymentDb": "Server=(localdb)\\mssqllocaldb;Database=PaymentDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "PaymentGateway": {
    "SimulatedLatencyMilliseconds": 150
  },
  "FaultInjection": {
    // true => the first N charge attempts of each correlation id fail with 503 (OrderService retries
    // with the SAME Idempotency-Key, so the card is never charged twice).
    "Enabled": false,
    "FailuresPerCorrelationId": 2,
    "StatusCode": 503,
    "PathPrefix": "/api/"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
