// File: src/OnlineStoreSystem.OrderService/appsettings.json
{
  "Urls": "http://localhost:5002",
  "ConnectionStrings": {
    // Override with env var ConnectionStrings__OrderDb=... (e.g. SQL auth on macOS/Linux).
    "OrderDb": "Server=(localdb)\\mssqllocaldb;Database=OrderDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Services": {
    "CatalogBaseUrl": "http://localhost:5001",
    "PaymentBaseUrl": "http://localhost:5004"
  },
  "Resilience": {
    // Microsoft.Extensions.Http.Resilience standard pipeline per downstream dependency.
    // Catalog: up to 1 + 4 attempts, backoff ~0.5s, 1s, 2s, 4s (+ jitter), 5s per attempt, 30s overall.
    "Catalog": {
      "MaxRetryAttempts": 4,
      "BaseDelayMilliseconds": 500,
      "UseJitter": true,
      "AttemptTimeoutSeconds": 5,
      "TotalTimeoutSeconds": 30,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerBreakSeconds": 15
    },
    // Payment: POST retried safely thanks to the Idempotency-Key header.
    "Payment": {
      "MaxRetryAttempts": 3,
      "BaseDelayMilliseconds": 500,
      "UseJitter": true,
      "AttemptTimeoutSeconds": 5,
      "TotalTimeoutSeconds": 20,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerBreakSeconds": 15
    }
  },
  "Saga": {
    "StockReservationTimeoutSeconds": 120,
    "PaymentRetryIntervalSeconds": 30,
    "MaxPaymentAttempts": 3,
    "CompensationRetryIntervalSeconds": 60,
    "MaxCompensationAttempts": 5,
    "RecoveryPollIntervalSeconds": 10
  },
  "Outbox": {
    "PollIntervalMilliseconds": 2000,
    "ErrorBackoffMilliseconds": 5000,
    "BatchSize": 50
  },
  "RabbitMq": {
    // Local broker (native install): amqp://guest:guest@localhost:5672/
    // CloudAMQP: set "ConnectionString": "amqps://<user>:<password>@<host>/<vhost>" (takes precedence).
    "ConnectionString": "",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientProvidedName": "OnlineStoreSystem.OrderService",
    // Topology: exchange onlinestore.events (topic) -> queue order.inventory-replies
    //           exchange onlinestore.dlx (direct)   -> queue order.inventory-replies.dlq
    "ExchangeName": "onlinestore.events",
    "DeadLetterExchangeName": "onlinestore.dlx",
    "DeadLetterQueueSuffix": ".dlq",
    "PrefetchCount": 10,
    "PublishConfirmTimeoutSeconds": 10,
    "ConnectRetryDelaySeconds": 5,
    "RequeueDelayMilliseconds": 1000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
