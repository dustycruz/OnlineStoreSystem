// File: src/OnlineStoreSystem.InventoryService/appsettings.json
{
  "Urls": "http://localhost:5003",
  "ConnectionStrings": {
    // Override with env var ConnectionStrings__InventoryDb=... (e.g. SQL auth on macOS/Linux).
    "InventoryDb": "Server=(localdb)\\mssqllocaldb;Database=InventoryDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "RabbitMq": {
    // Local broker (native install): amqp://guest:guest@localhost:5672/
    // CloudAMQP: set "ConnectionString": "amqps://<user>:<password>@<host>/<vhost>" (takes precedence).
    "ConnectionString": "",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientProvidedName": "OnlineStoreSystem.InventoryService",
    // Topology (declared idempotently at startup):
    //   exchange onlinestore.events (topic)  -> queues inventory.order-placed, inventory.order-outcomes
    //   exchange onlinestore.dlx (direct)    -> queues inventory.order-placed.dlq, inventory.order-outcomes.dlq
    "ExchangeName": "onlinestore.events",
    "DeadLetterExchangeName": "onlinestore.dlx",
    "DeadLetterQueueSuffix": ".dlq",
    "PrefetchCount": 10,
    "PublishConfirmTimeoutSeconds": 10,
    "ConnectRetryDelaySeconds": 5,
    "RequeueDelayMilliseconds": 1000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
